# 复制为 .env 后填写（scripts/setup.sh 会自动复制）。.env 不入库。

# ---------- 研报流水线（Claude Code harness）----------
# 订阅用户：运行 claude auth login 即可，下面这行保持注释。
# API 用户：取消注释并填写。注意不要留空值（空的 ANTHROPIC_API_KEY 会覆盖订阅登录）。
# ANTHROPIC_API_KEY=
# 走代理或网关时
# ANTHROPIC_BASE_URL=
# 模型分工：生成用 Opus，复核与质检用 Sonnet
FINAGENT_GEN_MODEL=claude-opus-5-5
FINAGENT_QC_MODEL=claude-sonnet-5-5
# 工作区与盲评目录（必须在仓库之外），默认 ~/finagent-samples 与 ~/finagent-evals
# FINAGENT_SAMPLES_DIR=
# FINAGENT_EVAL_DIR=
# HTML → PDF 用的浏览器，默认自动查找 Chrome / Chromium / Edge
# FINAGENT_CHROME=
