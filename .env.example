# 复制为 .env 后填写。任意 OpenAI 兼容接口均可。
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问（DashScope 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus
LLM_API_KEY=
# 双公司 DeepSeek Flash 对照测试专用；不影响上面的 Agent 默认模型。
DEEPSEEK_API_KEY=

# live：调用模型并写缓存 | replay：只读缓存离线复现 | off：仅规则通道
LLM_MODE=live
LLM_TEMPERATURE=0
LLM_SEED=42
