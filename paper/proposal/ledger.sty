  prog/.style={draw=progc,fill=progc!8,rounded corners=2pt,align=center,font=\small,inner sep=4pt,minimum height=7mm},
  agent/.style={draw=agentc,fill=agentc!12,rounded corners=2pt,align=center,font=\small,inner sep=4pt,minimum height=7mm},
  gate/.style={draw=gatec,fill=gatec!8,diamond,aspect=2.2,align=center,font=\scriptsize,inner sep=1pt},
  doc/.style={draw=mute,fill=white,align=center,font=\scriptsize,inner sep=3pt,minimum height=6mm},
  arr/.style={-{Stealth[length=2mm]},thick,color=ink!80},
  darr/.style={-{Stealth[length=2mm]},thick,dashed,color=ink!60},
}
\pgfplotsset{every axis/.append style={tick label style={font=\scriptsize},label style={font=\small},
  legend style={font=\scriptsize,draw=none},axis line style={ink!60},major tick style={ink!60}}}
